<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One canonical host: www -> non-www (HTTPS is enforced by the host's
    # "Force HTTPS" setting and the HSTS header below).
    RewriteCond %{HTTP_HOST} ^www\.krishnaoutdoor\.in$ [NC]
    RewriteRule ^ https://krishnaoutdoor.in%{REQUEST_URI} [L,R=301]

    # Flag versioned CSS/JS (?v=...) for the long cache header further down.
    RewriteCond %{QUERY_STRING} (^|&)v=
    RewriteRule \.(css|js)$ - [E=KO_VERSIONED_ASSET:1]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route bare "/admin" to the front controller even though "admin/" exists
    # as a real folder here (holding the admin panel's css/js/images) — Apache's
    # DirectorySlash redirects "/admin" to "/admin/" before the generic rule
    # below runs, and "/admin/" then 404s since there's no index file in that
    # folder. This must fire before the DirectorySlash redirect takes effect.
    RewriteRule ^admin/?$ index.php [L]

    # sitemap.xml and robots.txt are generated by Laravel (SeoController).
    # Send them to the front controller even if a stale static copy of
    # either file is left in this folder, which Apache would otherwise
    # serve first.
    RewriteRule ^(sitemap\.xml|robots\.txt)$ index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Text compression (Brotli where available, gzip otherwise).
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_headers.c>
    # Images, video and fonts: one year. Replace a file under a new name
    # (or a ?v= query) when its content changes.
    <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|mp4|webm|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS/JS: the layout links them with ?v=<file mtime>, so those URLs are
    # immutable. Anything requested without a version (e.g. admin assets)
    # is only cached for a day.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
        Header set Cache-Control "public, max-age=31536000, immutable" env=KO_VERSIONED_ASSET
    </FilesMatch>

    # Security headers.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Basic CSP: blocks framing by other sites, plugins, <base> hijacking and
    # off-site form posts. Scripts/styles are not restricted yet because the
    # site relies on inline scripts and admin-managed custom code.
    Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://api.whatsapp.com https://wa.me; upgrade-insecure-requests"
</IfModule>
